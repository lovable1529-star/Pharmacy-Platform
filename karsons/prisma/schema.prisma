// Karsons Pharmacy Platform — database schema
//
// Conventions:
//   - No hard deletes on clinical data. Use archivedAt, or create a new version.
//   - Every clinical table carries organisationId for tenant scoping.
//   - JSONB is used only for form schemas and rule trees — everything else is relational.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// TENANCY
// ─────────────────────────────────────────────────────────────

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// Cascading defaults: consent text, branding, retention periods
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies    Company[]
  users        User[]
  patients     Patient[]
  services     Service[]
  gpSurgeries  GpSurgery[]
  products     Product[]
  auditEvents  AuditEvent[]

  @@map("organisation")
}

model Company {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  /// GPhC premises registration for this legal entity
  gphcNumber     String?
  tradingName    String?
  addressLine1   String?
  addressLine2   String?
  town           String?
  postcode       String?
  /// Overrides organisation.settings
  settings       Json     @default("{}")
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  branches     Branch[]

  @@index([organisationId])
  @@map("company")
}

model Branch {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  code         String
  addressLine1 String?
  town         String?
  postcode     String?
  phone        String?
  /// Where prescriptions for this branch are emailed
  inboxEmail   String?
  timezone     String   @default("Europe/Isle_of_Man")
  settings     Json     @default("{}")
  archivedAt   DateTime?
  createdAt    DateTime @default(now())

  company       Company        @relation(fields: [companyId], references: [id])
  resources     Resource[]
  appointments  Appointment[]
  consultations Consultation[]
  stockLevels   StockLevel[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branch")
}

model Resource {
  id       String       @id @default(cuid())
  branchId String
  name     String
  type     ResourceType
  active   Boolean      @default(true)

  branch       Branch        @relation(fields: [branchId], references: [id])
  appointments Appointment[]

  @@index([branchId])
  @@map("resource")
}

enum ResourceType {
  CONSULTATION_ROOM
  CLINICIAN
  TABLET
}

// ─────────────────────────────────────────────────────────────
// USERS, ROLES, CLINICIANS
// ─────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  organisationId String
  /// Supabase Auth user id
  authId         String?  @unique
  email          String   @unique
  fullName       String
  phone          String?
  active         Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())

  organisation    Organisation     @relation(fields: [organisationId], references: [id])
  roleAssignments RoleAssignment[]
  clinician       Clinician?
  auditEvents     AuditEvent[]

  @@index([organisationId])
  @@map("user")
}

/// Role scoped to a level of the tenancy tree. A null companyId/branchId
/// means the role applies organisation-wide.
model RoleAssignment {
  id        String    @id @default(cuid())
  userId    String
  role      Role
  companyId String?
  branchId  String?
  /// Locum access expires automatically
  validFrom DateTime  @default(now())
  validTo   DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("role_assignment")
}

enum Role {
  OWNER
  ADMIN
  PHARMACIST
  TECHNICIAN
  RECEPTION
  READ_ONLY
}

/// Registration details for a user who can perform clinical actions.
model Clinician {
  id            String    @id @default(cuid())
  userId        String    @unique
  /// GPhC registration number — auto-filled onto prescriptions
  gphcNumber    String
  signatureUrl  String?
  qualification String?
  active        Boolean   @default(true)

  user          User           @relation(fields: [userId], references: [id])
  consultations Consultation[]
  prescriptions Prescription[]

  @@map("clinician")
}

// ─────────────────────────────────────────────────────────────
// PATIENTS
// ─────────────────────────────────────────────────────────────

model Patient {
  id             String    @id @default(cuid())
  organisationId String
  firstName      String
  lastName       String
  dateOfBirth    DateTime  @db.Date
  gender         String?
  /// Free text when gender is "Other"
  genderSelfDescribed String?
  email          String?
  phone          String?
  addressLine1   String?
  addressLine2   String?
  town           String?
  postcode       String?
  gpSurgeryId    String?
  /// Surfaced at the top of the record — e.g. interpreter required
  alerts         Json      @default("[]")
  /// Accessibility needs
  accessibility  Json      @default("{}")
  archivedAt     DateTime?
  /// Set when this record was merged into another
  mergedIntoId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation  Organisation        @relation(fields: [organisationId], references: [id])
  gpSurgery     GpSurgery?          @relation(fields: [gpSurgeryId], references: [id])
  identifiers   PatientIdentifier[]
  allergies     Allergy[]
  submissions   Submission[]
  appointments  Appointment[]
  consultations Consultation[]
  prescriptions Prescription[]
  documents     Document[]
  messages      Message[]
  consents      ConsentRecord[]
  repeatEnrolment RepeatEnrolment?

  @@index([organisationId, lastName])
  @@index([organisationId, dateOfBirth])
  @@map("patient")
}

/// External identifiers — e.g. Pharmadoctor ID, NHS number
model PatientIdentifier {
  id        String @id @default(cuid())
  patientId String
  system    String
  value     String

  patient Patient @relation(fields: [patientId], references: [id])

  @@unique([system, value])
  @@index([patientId])
  @@map("patient_identifier")
}

model Allergy {
  id         String    @id @default(cuid())
  patientId  String
  substance  String
  reaction   String?
  severity   String?
  recordedAt DateTime  @default(now())
  archivedAt DateTime?

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("allergy")
}

model GpSurgery {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  /// Hidden field — auto-filled from the surgery selection
  email          String
  phone          String?
  address        String?
  active         Boolean  @default(true)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  patients     Patient[]

  @@index([organisationId])
  @@map("gp_surgery")
}

// ─────────────────────────────────────────────────────────────
// SERVICES & FORMS  (the configuration engine)
// ─────────────────────────────────────────────────────────────

model Service {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  slug           String
  description    String?
  category       String?
  /// Price in pence
  priceMinor     Int      @default(0)
  active         Boolean  @default(false)
  createdAt      DateTime @default(now())

  organisation  Organisation     @relation(fields: [organisationId], references: [id])
  versions      ServiceVersion[]
  appointments  Appointment[]
  consultations Consultation[]

  @@unique([organisationId, slug])
  @@map("service")
}

/// Published versions are immutable. In-flight submissions stay bound to the
/// version they started on, so editing a form never changes historical answers.
model ServiceVersion {
  id          String    @id @default(cuid())
  serviceId   String
  version     Int
  /// Patient-facing form definition
  patientForm Json
  /// Clinician-side form definition
  clinicianForm Json?
  /// Pharmacist declarations shown before submission
  declarations Json     @default("[]")
  /// Which documents generate and which emails send
  outputs     Json      @default("[]")
  rulesetId   String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  service     Service      @relation(fields: [serviceId], references: [id])
  ruleset     RulesetVersion? @relation(fields: [rulesetId], references: [id])
  submissions Submission[]

  @@unique([serviceId, version])
  @@map("service_version")
}

model Submission {
  id               String           @id @default(cuid())
  organisationId   String
  serviceVersionId String
  patientId        String?
  status           SubmissionStatus @default(DRAFT)
  /// Answers keyed by field id — validated against the bound schema version
  answers          Json             @default("{}")
  /// Files, photos and ID uploads
  attachments      Json             @default("[]")
  submittedAt      DateTime?
  /// Set when the patient completed this in branch on a tablet
  completedInBranch Boolean         @default(false)
  createdAt        DateTime         @default(now())

  serviceVersion ServiceVersion   @relation(fields: [serviceVersionId], references: [id])
  patient        Patient?         @relation(fields: [patientId], references: [id])
  consultation   Consultation?
  evaluations    RuleEvaluation[]

  @@index([organisationId, status])
  @@index([patientId])
  @@map("submission")
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────
// DECISION ENGINE
// ─────────────────────────────────────────────────────────────

model Ruleset {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())

  versions RulesetVersion[]

  @@map("ruleset")
}

/// Published rule versions are immutable. The simulator replays historical
/// submissions against a draft version before it goes live.
model RulesetVersion {
  id          String    @id @default(cuid())
  rulesetId   String
  version     Int
  /// The condition tree — see src/types/rule-schema.ts
  definition  Json
  publishedAt DateTime?
  publishedBy String?
  createdAt   DateTime  @default(now())

  ruleset         Ruleset          @relation(fields: [rulesetId], references: [id])
  serviceVersions ServiceVersion[]
  evaluations     RuleEvaluation[]

  @@unique([rulesetId, version])
  @@map("ruleset_version")
}

/// Full audit of a decision: which rules fired, in what order, and why.
model RuleEvaluation {
  id               String   @id @default(cuid())
  submissionId     String
  rulesetVersionId String
  outcome          Outcome
  /// Ordered list of every rule evaluated and its result
  trace            Json
  /// Computed values used in evaluation — BMI, weeks on dose, weight loss %
  derived          Json     @default("{}")
  evaluatedAt      DateTime @default(now())

  submission     Submission     @relation(fields: [submissionId], references: [id])
  rulesetVersion RulesetVersion @relation(fields: [rulesetVersionId], references: [id])

  @@index([submissionId])
  @@map("rule_evaluation")
}

enum Outcome {
  GREEN
  AMBER
  RED
}

// ─────────────────────────────────────────────────────────────
// SCHEDULING
// ─────────────────────────────────────────────────────────────

model Appointment {
  id             String            @id @default(cuid())
  organisationId String
  branchId       String
  serviceId      String?
  patientId      String?
  resourceId     String?
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(BOOKED)
  /// WEB, QR, STAFF, WALK_IN
  source         String            @default("WEB")
  notes          String?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  branch       Branch        @relation(fields: [branchId], references: [id])
  service      Service?      @relation(fields: [serviceId], references: [id])
  patient      Patient?      @relation(fields: [patientId], references: [id])
  resource     Resource?     @relation(fields: [resourceId], references: [id])
  consultation Consultation?

  @@index([organisationId, startsAt])
  @@index([branchId, startsAt])
  @@map("appointment")
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Availability {
  id         String   @id @default(cuid())
  branchId   String
  serviceId  String?
  /// 0 = Sunday
  dayOfWeek  Int
  startTime  String
  endTime    String
  slotMinutes Int     @default(15)
  active     Boolean  @default(true)

  @@index([branchId])
  @@map("availability")
}

model WaitlistEntry {
  id             String   @id @default(cuid())
  organisationId String
  branchId       String
  serviceId      String?
  patientId      String?
  contactName    String
  contactPhone   String?
  contactEmail   String?
  notifiedAt     DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([organisationId, branchId])
  @@map("waitlist_entry")
}

// ─────────────────────────────────────────────────────────────
// CONSULTATIONS
// ─────────────────────────────────────────────────────────────

model Consultation {
  id             String             @id @default(cuid())
  organisationId String
  branchId       String
  serviceId      String
  patientId      String
  clinicianId    String?
  submissionId   String?            @unique
  appointmentId  String?            @unique
  status         ConsultationStatus @default(IN_PROGRESS)
  /// Clinician-side answers
  clinicalData   Json               @default("{}")
  /// Signed pharmacist declarations
  declarations   Json               @default("[]")
  notes          String?
  /// NHS | PAID
  fundingType    String?
  identityVerified Boolean          @default(false)
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  branch        Branch          @relation(fields: [branchId], references: [id])
  service       Service         @relation(fields: [serviceId], references: [id])
  patient       Patient         @relation(fields: [patientId], references: [id])
  clinician     Clinician?      @relation(fields: [clinicianId], references: [id])
  submission    Submission?     @relation(fields: [submissionId], references: [id])
  appointment   Appointment?    @relation(fields: [appointmentId], references: [id])
  actions       ClinicalAction[]
  documents     Document[]
  prescriptions Prescription[]

  @@index([organisationId, status])
  @@index([patientId])
  @@map("consultation")
}

enum ConsultationStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

/// A discrete clinical act — a vaccine administered, a medicine supplied.
/// This is what decrements stock and what gets reported to the GP.
model ClinicalAction {
  id             String   @id @default(cuid())
  consultationId String
  type           String
  productId      String?
  batchId        String?
  /// Right Deltoid, Left Thigh, Oral, Nasal...
  siteOfAdministration String?
  /// Intramuscular, Subcutaneous, Subdermal
  routeOfAdministration String?
  quantity       Int      @default(1)
  performedAt    DateTime @default(now())
  metadata       Json     @default("{}")

  consultation Consultation @relation(fields: [consultationId], references: [id])
  product      Product?     @relation(fields: [productId], references: [id])
  batch        Batch?       @relation(fields: [batchId], references: [id])

  @@index([consultationId])
  @@index([batchId])
  @@map("clinical_action")
}

// ─────────────────────────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────────────────────────

model Product {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  /// VACCINE | MEDICINE | CONSUMABLE
  type           String
  manufacturer   String?
  /// Substances to cross-check against patient allergies
  allergens      Json     @default("[]")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organisation Organisation     @relation(fields: [organisationId], references: [id])
  batches      Batch[]
  actions      ClinicalAction[]
  stockLevels  StockLevel[]

  @@index([organisationId])
  @@map("product")
}

model Batch {
  id         String   @id @default(cuid())
  productId  String
  batchNumber String
  expiryDate DateTime @db.Date
  recalledAt DateTime?
  recallReason String?
  createdAt  DateTime @default(now())

  product        Product          @relation(fields: [productId], references: [id])
  actions        ClinicalAction[]
  stockMovements StockMovement[]
  stockLevels    StockLevel[]

  @@unique([productId, batchNumber])
  @@map("batch")
}

model StockLevel {
  id        String @id @default(cuid())
  branchId  String
  productId String
  batchId   String
  quantity  Int    @default(0)

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  batch   Batch   @relation(fields: [batchId], references: [id])

  @@unique([branchId, batchId])
  @@map("stock_level")
}

/// Append-only ledger. Stock levels are derived from this.
model StockMovement {
  id        String   @id @default(cuid())
  branchId  String
  batchId   String
  /// RECEIPT | ADMINISTRATION | WASTAGE | TRANSFER_IN | TRANSFER_OUT | ADJUSTMENT
  type      String
  quantity  Int
  reason    String?
  reference String?
  createdBy String?
  createdAt DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id])

  @@index([branchId, batchId])
  @@map("stock_movement")
}

// ─────────────────────────────────────────────────────────────
// DOCUMENTS & PRESCRIPTIONS
// ─────────────────────────────────────────────────────────────

model DocumentTemplate {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  /// PRESCRIPTION | VACCINATION_RECORD | CONSULTATION_SUMMARY | GP_NOTIFICATION
  type           String
  definition     Json
  version        Int      @default(1)
  active         Boolean  @default(true)

  @@map("document_template")
}

/// Generated documents are immutable. Storage uses write-once semantics.
model Document {
  id             String   @id @default(cuid())
  organisationId String
  patientId      String?
  consultationId String?
  type           String
  filename       String
  storagePath    String
  /// SHA-256 of the file, proving it has not been altered
  contentHash    String
  sizeBytes      Int?
  createdAt      DateTime @default(now())

  patient      Patient?      @relation(fields: [patientId], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id])

  @@index([patientId])
  @@map("document")
}

model Prescription {
  id             String   @id @default(cuid())
  organisationId String
  /// Sequential, human-readable — e.g. KP-2026-000412
  prescriptionNo String   @unique
  patientId      String
  consultationId String?
  clinicianId    String
  branchId       String
  medicineName   String
  strength       String
  dose           String
  quantity       String
  durationMonths Int?
  priceMinor     Int      @default(0)
  paymentStatus  String   @default("UNPAID")
  /// Flags for the dispensing pharmacist — e.g. patient asked a question
  dispenserFlags Json     @default("[]")
  documentId     String?
  issuedAt       DateTime @default(now())
  /// Corrections create a new prescription referencing the original
  supersedesId   String?

  patient      Patient       @relation(fields: [patientId], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id])
  clinician    Clinician     @relation(fields: [clinicianId], references: [id])

  @@index([organisationId, issuedAt])
  @@index([patientId])
  @@map("prescription")
}

// ─────────────────────────────────────────────────────────────
// COMMUNICATIONS
// ─────────────────────────────────────────────────────────────

model MessageTemplate {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  channel        Channel
  subject        String?
  body           String
  active         Boolean  @default(true)

  @@map("message_template")
}

model Message {
  id             String        @id @default(cuid())
  organisationId String
  patientId      String?
  /// Where a GP notification was sent
  gpSurgeryId    String?
  channel        Channel
  recipient      String
  subject        String?
  body           String
  status         MessageStatus @default(QUEUED)
  /// Provider message id, for reconciling delivery events
  providerRef    String?
  /// Groups a batched end-of-day GP mailout
  batchId        String?
  sentAt         DateTime?
  failedReason   String?
  createdAt      DateTime      @default(now())

  patient Patient?        @relation(fields: [patientId], references: [id])
  events  DeliveryEvent[]

  @@index([organisationId, status])
  @@index([patientId])
  @@index([batchId])
  @@map("message")
}

enum Channel {
  EMAIL
  SMS
  WHATSAPP
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

model DeliveryEvent {
  id         String   @id @default(cuid())
  messageId  String
  type       String
  payload    Json     @default("{}")
  occurredAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id])

  @@index([messageId])
  @@map("delivery_event")
}

// ─────────────────────────────────────────────────────────────
// REPEAT CARE  (GLP-1)
// ─────────────────────────────────────────────────────────────

/// A patient authorised by a pharmacist to use the repeat request tool.
/// Enrolment is deliberate — patients cannot self-enrol.
model RepeatEnrolment {
  id              String    @id @default(cuid())
  patientId       String    @unique
  externalId      String    @unique
  enrolledAt      DateTime  @default(now())
  enrolledBy      String?
  baselineMedicine String
  baselineStrength String
  baselineWeightKg Float?
  heightCm         Float?
  active           Boolean  @default(true)
  suspendedReason  String?

  patient  Patient        @relation(fields: [patientId], references: [id])
  supplies RepeatSupply[]

  @@map("repeat_enrolment")
}

/// One record per supply, whether requested online or logged by a pharmacist
/// in branch — otherwise the repeat history has gaps.
model RepeatSupply {
  id           String   @id @default(cuid())
  enrolmentId  String
  submissionId String?
  medicine     String
  strength     String
  months       Int      @default(1)
  weightKg     Float?
  waistCm      Float?
  outcome      Outcome?
  /// Set when a pharmacist overrode or confirmed an AMBER
  reviewedBy   String?
  reviewNote   String?
  suppliedAt   DateTime @default(now())

  enrolment RepeatEnrolment @relation(fields: [enrolmentId], references: [id])

  @@index([enrolmentId, suppliedAt])
  @@map("repeat_supply")
}

// ─────────────────────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────────────────────

model Payment {
  id             String   @id @default(cuid())
  organisationId String
  patientId      String?
  consultationId String?
  amountMinor    Int
  currency       String   @default("GBP")
  status         String   @default("PENDING")
  provider       String   @default("stripe")
  providerRef    String?
  /// ONLINE | ON_COLLECTION
  method         String?
  paidAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([organisationId, status])
  @@map("payment")
}

// ─────────────────────────────────────────────────────────────
// CONSENT & COMPLIANCE
// ─────────────────────────────────────────────────────────────

/// Consent text is versioned so we can always prove which wording
/// a patient agreed to, and when.
model ConsentTextVersion {
  id             String   @id @default(cuid())
  organisationId String
  key            String
  version        Int
  body           String
  publishedAt    DateTime @default(now())

  records ConsentRecord[]

  @@unique([organisationId, key, version])
  @@map("consent_text_version")
}

model ConsentRecord {
  id             String   @id @default(cuid())
  patientId      String
  consentTextId  String
  granted        Boolean
  /// Base64 signature image captured on the device
  signatureData  String?
  /// SHA-256 of signature + text version + timestamp
  signatureHash  String?
  ipAddress      String?
  userAgent      String?
  recordedAt     DateTime @default(now())

  patient     Patient            @relation(fields: [patientId], references: [id])
  consentText ConsentTextVersion @relation(fields: [consentTextId], references: [id])

  @@index([patientId])
  @@map("consent_record")
}

/// Append-only and hash-chained. Each entry stores the hash of the previous
/// entry, so any tampering breaks the chain and is detectable.
model AuditEvent {
  id             String   @id @default(cuid())
  organisationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  /// Hash of the previous audit event in this organisation's chain
  previousHash   String?
  /// SHA-256 of this event's canonical content plus previousHash
  hash           String
  occurredAt     DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organisationId, occurredAt])
  @@index([entityType, entityId])
  @@map("audit_event")
}

model RetentionPolicy {
  id             String   @id @default(cuid())
  organisationId String
  entityType     String
  retainMonths   Int
  /// PURGE_PII | DELETE | ARCHIVE
  action         String   @default("PURGE_PII")
  active         Boolean  @default(true)

  @@map("retention_policy")
}

model DsarRequest {
  id             String    @id @default(cuid())
  organisationId String
  patientId      String?
  requesterEmail String
  /// ACCESS | ERASURE | RECTIFICATION | PORTABILITY
  type           String
  status         String    @default("RECEIVED")
  /// Statutory deadline — one calendar month
  dueAt          DateTime
  completedAt    DateTime?
  exportPath     String?
  notes          String?
  createdAt      DateTime  @default(now())

  @@index([organisationId, status])
  @@map("dsar_request")
}

/// Pharmacy governance requirement, and useful evidence at inspection.
model IncidentLog {
  id             String   @id @default(cuid())
  organisationId String
  branchId       String?
  /// NEAR_MISS | INCIDENT | BREACH
  type           String
  severity       String
  description    String
  actionTaken    String?
  reportedBy     String?
  occurredAt     DateTime
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([organisationId, occurredAt])
  @@map("incident_log")
}
