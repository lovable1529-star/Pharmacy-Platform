# Supabase — London (eu-west-2). Pooled 6543 for the app, direct 5432 for migrations.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Email — Resend. SPF, DKIM and DMARC must all be aligned or gov.im silently drops.
RESEND_API_KEY=""
EMAIL_FROM="clinic@karsonspharmacy.co.uk"

# SMS and WhatsApp — Twilio. Optional: without these, messages for those
# channels queue as UNAVAILABLE rather than being lost, and send once filled in.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""

# Where AMBER and RED alerts go when a branch has no mailbox of its own.
CLINIC_ALERT_EMAIL="clinic@karsonspharmacy.co.uk"
# E.164, e.g. +447624000000. WhatsApp alerts queue until this and Twilio exist.
PHARMACIST_WHATSAPP_TO=""

# Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3100"
CRON_SECRET=""
